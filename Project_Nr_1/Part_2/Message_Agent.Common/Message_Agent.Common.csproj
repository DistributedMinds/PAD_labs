<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Protos\notify.proto" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Google.Protobuf" Version="3.*" />
		<PackageReference Include="Grpc.Net.Client" Version="2.*" />
		<PackageReference Include="Grpc.Tools" Version="2.*" PrivateAssets="All" />
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="Protos\notify.proto" />
		<Protobuf Include="Protos\publish.proto" GrpcServices="Both" />
		<Protobuf Include="Protos\subscribe.proto" GrpcServices="Both" />
		<Protobuf Include="Protos\auth.proto" GrpcServices="Both" />
	</ItemGroup>

</Project>